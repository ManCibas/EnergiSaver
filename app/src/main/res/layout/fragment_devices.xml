<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:text="Dispositivos"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#333333" />

    <!-- A lista agora fica entre o título e o botão -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvDevices"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/tvTitle"
        android:layout_above="@id/btnAddNewDevice"
        android:paddingBottom="16dp"
        android:clipToPadding="false" />

    <!-- Botão de Adicionar (Estilo do mockup) -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnAddNewDevice"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentBottom="true"
        android:layout_margin="16dp"
        android:background="@drawable/bg_button_green"
        android:backgroundTint="@null"
        android:text="+ Adicionar Novo Dispositivo"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

</RelativeLayout>