<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_home_header"
    android:backgroundTint="#FFFFFF">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center"
        android:background="#DDDDDD"
        android:layout_marginBottom="16dp"/>

    <!-- Contentor do Nome com Ícone de Edição (Caneta) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <EditText
            android:id="@+id/etEditDeviceName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:background="@null"
            android:hint="Nome do Dispositivo" />

        <ImageView
            android:id="@+id/ivEditDeviceName"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:src="@android:drawable/ic_menu_edit"
            app:tint="#757575" />
    </LinearLayout>

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchDeviceStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text=""
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tvDetailConsumption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Consumo: 0.0 W"
        android:textColor="#757575"
        android:layout_marginBottom="16dp"/>


    <!-- Gráfico Individual -->
    <com.github.mikephil.charting.charts.LineChart
        android:id="@+id/detailLineChart"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/btnUpdateDevice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Guardar Alterações"
        android:backgroundTint="#27AE60"
        android:textColor="#FFFFFF" />

    <Button
        android:id="@+id/btnDeleteDeviceDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Eliminar Dispositivo"
        android:layout_marginTop="8dp"
        android:backgroundTint="#EB5757"
        android:textColor="#FFFFFF" />

</LinearLayout>